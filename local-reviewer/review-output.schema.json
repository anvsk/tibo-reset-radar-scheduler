{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "summaryZh": { "type": "string" },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sourceAccount": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["searched", "unavailable"]
          },
          "note": { "type": "string" }
        },
        "required": ["sourceAccount", "status", "note"],
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sourceAccount": { "type": "string" },
          "url": { "type": "string" },
          "publishedAt": { "type": "string" },
          "author": { "type": "string" },
          "verdict": {
            "type": "string",
            "enum": ["predictive", "contradicting"]
          },
          "reasonKey": {
            "type": "string",
            "enum": [
              "upcoming_reset_rumor",
              "reported_reset",
              "banked_reset",
              "extra_reset",
              "no_reset_or_delay"
            ]
          },
          "confidence": {
            "type": "integer",
            "minimum": 80,
            "maximum": 100
          },
          "summaryZh": { "type": "string" },
          "reason": { "type": "string" }
        },
        "required": [
          "sourceAccount",
          "url",
          "publishedAt",
          "author",
          "verdict",
          "reasonKey",
          "confidence",
          "summaryZh",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["summaryZh", "coverage", "findings"],
  "additionalProperties": false
}
